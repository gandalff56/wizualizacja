{
  "_comment": "Translation rules for Fanuc alarms and operator messages. Add your own entries to get friendly Polish descriptions and lists of possible causes. Each rule has: type ('alarm' or 'operator'), match ('exact' | 'contains' | 'regex'), pattern (string or regex with groups), friendly (template; {1},{2},... are regex groups), severity ('info' | 'waiting' | 'warning' | 'error'), causes (list of strings).",
  "rules": [
    {
      "type": "operator",
      "match": "contains",
      "pattern": "Waiting for data to be processed by the office",
      "friendly": "Oczekiwanie: biuro przetwarza dane zlecenia",
      "severity": "waiting",
      "causes": [
        "Biuro nie wyslalo jeszcze aktualizacji geometrii",
        "Polaczenie z serwerem biura jest zerwane",
        "Zlecenie produkcyjne nie zostalo jeszcze zatwierdzone w systemie"
      ]
    },
    {
      "type": "operator",
      "match": "regex",
      "pattern": "^(B\\d+)_PRD-(\\d+)_DEV(\\d+)_F\\s+loaded",
      "friendly": "Program {1} (wariant DEV{3}, zlecenie {2}) zaladowany",
      "severity": "info",
      "causes": []
    },
    {
      "type": "operator",
      "match": "contains",
      "pattern": "LASER SCAN",
      "friendly": "Laser skaner - sprawdz stan soczewki",
      "severity": "warning",
      "causes": [
        "Soczewka lasera jest zanieczyszczona (komunikat 'DIRTY')",
        "Laser nie dostaje zasilania",
        "Zla orientacja glowicy wzgledem powierzchni"
      ]
    },
    {
      "type": "operator",
      "match": "exact",
      "pattern": "Program start",
      "friendly": "Program wystartowal",
      "severity": "info",
      "causes": []
    },
    {
      "type": "alarm",
      "match": "regex",
      "pattern": "^SV(\\d+)",
      "friendly": "Servo alarm - os {axis}",
      "severity": "error",
      "causes": [
        "Kolizja w czasie ruchu (sprawdz osatnio wykonywane komendy)",
        "Przekroczone obciazenie serwa (za duza masa na osi)",
        "Przerwa w komunikacji ze wzmacniaczem serwa (migajace diody)"
      ]
    },
    {
      "type": "alarm",
      "match": "regex",
      "pattern": "^OT(\\d+)",
      "friendly": "Overtravel - os {axis} poza limitem",
      "severity": "error",
      "causes": [
        "Os dojechala do stopu miekkiego (parametry 1320/1321)",
        "Stop twardy (koncowka) wyzwolona",
        "Po resecie cofnij os recznym jogiem w przeciwna strone"
      ]
    },
    {
      "type": "alarm",
      "match": "regex",
      "pattern": "^PS(\\d+)",
      "friendly": "Program / syntax alarm",
      "severity": "error",
      "causes": [
        "Bledny format komendy G/M",
        "Brakujacy parametr w linii",
        "Niewlasciwa wartosc adresu (np. Z bez wartosci)"
      ]
    },
    {
      "type": "alarm",
      "match": "regex",
      "pattern": "^SP(\\d+)",
      "friendly": "Spindle alarm",
      "severity": "error",
      "causes": [
        "Przegrzanie silnika wrzeciona",
        "Blad enkodera wrzeciona",
        "Przekroczone obciazenie (za agresywne ciecie)"
      ]
    }
  ]
}
