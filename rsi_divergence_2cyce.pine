//@version=6
// ═════════════════════════════════════════════════════════════════════════════
//  RSI DIVERGENCE + „2 CYCE”  (Pine Script v6)
//  ───────────────────────────────────────────────────────────────────────────
//  Wskaźnik wykrywa na POTWIERDZONYCH pivotach:
//   • Regular Bullish Divergence  – cena robi LL, RSI robi HL
//   • Hidden  Bullish Divergence  – cena robi HL, RSI robi LL
//   • Hidden  Bearish Divergence  – cena robi LH, RSI robi HH
//   • Regular Bearish Divergence  – cena robi HH, RSI robi LH
//   • Formację „2 cyce”           – dwa zbliżone szczyty (lub dołki) na cenie
//                                    z dołkiem (szczytem) pomiędzy nimi
//
//  Dywergencje liczone są na pivotach RSI (ta.pivothigh / ta.pivotlow na RSI),
//  a formacja „2 cyce” na pivotach CENY. Sygnał powstaje dopiero po
//  potwierdzeniu pivota (Pivot Right Bars) — bez repaintujących trików:
//  brak request.security / lookahead, rysowanie wykonywane jest jeden raz,
//  w barze potwierdzenia pivota.
// ═════════════════════════════════════════════════════════════════════════════
indicator("RSI Divergence + 2 Cyce", shorttitle = "RSI Div + 2C", overlay = false, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════════════════════════════════════════════════════════
//  1. INPUTS — USTAWIENIA
// ═════════════════════════════════════════════════════════════════════════════

// ── RSI ──────────────────────────────────────────────────────────────────────
grpRsi = "RSI"
rsiLen = input.int(14, "RSI Length", minval = 2, group = grpRsi)
rsiSrc = input.source(close, "RSI Source", group = grpRsi)
colRsi = input.color(#7e57c2, "Kolor linii RSI", group = grpRsi)

// ── Pivoty i filtry ──────────────────────────────────────────────────────────
grpPiv     = "Pivoty i filtry"
pivLeft    = input.int(5, "Pivot Left Bars", minval = 1, group = grpPiv, tooltip = "Liczba barów z lewej strony pivota.")
pivRight   = input.int(5, "Pivot Right Bars", minval = 1, group = grpPiv, tooltip = "Liczba barów z prawej strony pivota. Pivot (i sygnał) potwierdza się dopiero po tylu barach — to celowe opóźnienie chroni przed repaintingiem.")
minDist    = input.int(5, "Min. odległość między pivotami (bary)", minval = 1, group = grpPiv, tooltip = "Minimalny odstęp (w barach) między dwoma pivotami tworzącymi formację. Musi być mniejszy niż odległość maksymalna.")
maxDist    = input.int(60, "Max. odległość między pivotami (bary)", minval = 2, group = grpPiv)
minRsiDiff = input.float(1.0, "Min. różnica RSI między pivotami", minval = 0.0, step = 0.5, group = grpPiv, tooltip = "Filtr słabych dywergencji: wymagana minimalna bezwzględna różnica wartości RSI między dwoma pivotami.")

// ── Siła dywergencji ─────────────────────────────────────────────────────────
grpStr      = "Siła dywergencji"
minDivStr   = input.float(0.0, "Min. siła dywergencji (0–100)", minval = 0.0, maxval = 100.0, step = 5.0, group = grpStr, tooltip = "Każda dywergencja dostaje ocenę siły 0–100 (50 pkt za rozjazd RSI + 50 pkt za ruch ceny między pivotami). Dywergencje słabsze niż próg są pomijane; 0 = brak filtra.")
showStrDiv  = input.bool(true, "Pokaż siłę w etykiecie", group = grpStr, tooltip = "Dopisuje ocenę siły (0–100) do tekstu etykiety, np. „Bull 72”.")
strRsiScale = input.float(20.0, "Skala RSI: ΔRSI = pełne 50 pkt", minval = 1.0, step = 1.0, group = grpStr, tooltip = "Różnica RSI między pivotami, przy której składnik RSI osiąga maksimum (50 pkt).")
strPrcScale = input.float(5.0, "Skala ceny: Δcena % = pełne 50 pkt", minval = 0.1, step = 0.1, group = grpStr, tooltip = "Procentowa zmiana ceny między pivotami, przy której składnik cenowy osiąga maksimum (50 pkt).")

// ── Dywergencje: przełączniki i style (kolor / styl / grubość) ───────────────
grpDiv = "Dywergencje — przełączniki i style"
showRegBull = input.bool(true, "Show Regular Bull", inline = "d1", group = grpDiv, tooltip = "Zwykła bycza: cena niższy dołek (LL), RSI wyższy dołek (HL).")
colRegBull  = input.color(#089981, "", inline = "d1", group = grpDiv)
styRegBull  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "d1", group = grpDiv)
widRegBull  = input.int(2, "", minval = 1, maxval = 5, inline = "d1", group = grpDiv)

showHidBull = input.bool(true, "Show Hidden Bull", inline = "d2", group = grpDiv, tooltip = "Ukryta bycza: cena wyższy dołek (HL), RSI niższy dołek (LL).")
colHidBull  = input.color(#00bcd4, "", inline = "d2", group = grpDiv)
styHidBull  = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "d2", group = grpDiv)
widHidBull  = input.int(1, "", minval = 1, maxval = 5, inline = "d2", group = grpDiv)

showHidBear = input.bool(true, "Show Hidden Bear", inline = "d3", group = grpDiv, tooltip = "Ukryta niedźwiedzia: cena niższy szczyt (LH), RSI wyższy szczyt (HH).")
colHidBear  = input.color(#ff9800, "", inline = "d3", group = grpDiv)
styHidBear  = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], inline = "d3", group = grpDiv)
widHidBear  = input.int(1, "", minval = 1, maxval = 5, inline = "d3", group = grpDiv)

showRegBear = input.bool(true, "Show Regular Bear", inline = "d4", group = grpDiv, tooltip = "Zwykła niedźwiedzia: cena wyższy szczyt (HH), RSI niższy szczyt (LH).")
colRegBear  = input.color(#f23645, "", inline = "d4", group = grpDiv)
styRegBear  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "d4", group = grpDiv)
widRegBear  = input.int(2, "", minval = 1, maxval = 5, inline = "d4", group = grpDiv)

// ── Formacja „2 cyce” ────────────────────────────────────────────────────────
grp2c    = "Formacja „2 cyce”"
show2c   = input.bool(true, "Show 2 Cyce", group = grp2c, tooltip = "Dwa kolejne, zbliżone wysokością szczyty (lub dołki) na cenie, z potwierdzonym dołkiem (szczytem) pomiędzy nimi.")
tol2c    = input.float(0.5, "Tolerancja wysokości (%)", minval = 0.05, maxval = 5.0, step = 0.05, group = grp2c, tooltip = "Maksymalna procentowa różnica wysokości obu szczytów/dołków (typowo 0.3–1.5%). Liczona względem średniej obu wartości.")
col2cTop = input.color(#e040fb, "Kolor: szczyty", inline = "c1", group = grp2c)
col2cBot = input.color(#29b6f6, "Kolor: dołki", inline = "c1", group = grp2c)
sty2c    = input.string("Dotted", "Styl", options = ["Solid", "Dashed", "Dotted"], inline = "c2", group = grp2c)
wid2c    = input.int(2, "Grubość", minval = 1, maxval = 5, inline = "c2", group = grp2c)

// ── Wyświetlanie ─────────────────────────────────────────────────────────────
grpVis         = "Wyświetlanie"
showPriceLines = input.bool(true, "Pokaż linie dywergencji na wykresie ceny", group = grpVis, tooltip = "Oprócz panelu RSI dywergencje rysowane są też na głównym wykresie (po cenie: low/high).")
showLabels     = input.bool(true, "Pokaż etykiety", group = grpVis, tooltip = "Etykieta przy drugiej nodze każdej formacji.")

// ── Poziomy RSI ──────────────────────────────────────────────────────────────
grpLvl     = "Poziomy RSI"
showLevels = input.bool(true, "Pokaż poziomy RSI (70 / 50 / 30)", group = grpLvl)
lvlOB      = input.float(70.0, "Poziom wykupienia", minval = 50.0, maxval = 100.0, group = grpLvl)
lvlMid     = input.float(50.0, "Poziom środkowy", minval = 0.0, maxval = 100.0, group = grpLvl)
lvlOS      = input.float(30.0, "Poziom wyprzedania", minval = 0.0, maxval = 50.0, group = grpLvl)
showFill   = input.bool(true, "Wypełnienie strefy 30–70", group = grpLvl)
colFill    = input.color(color.new(#7e57c2, 90), "Kolor wypełnienia", group = grpLvl)

// ═════════════════════════════════════════════════════════════════════════════
//  2. CALCULATIONS — OBLICZENIA I FUNKCJE POMOCNICZE
// ═════════════════════════════════════════════════════════════════════════════

// Wartość RSI
rsiVal = ta.rsi(rsiSrc, rsiLen)

// Pivoty na RSI (do wykrywania dywergencji) — wartość różna od `na` pojawia się
// wyłącznie w barze POTWIERDZENIA pivota, czyli pivRight barów po ekstremum
rsiPH = ta.pivothigh(rsiVal, pivLeft, pivRight)
rsiPL = ta.pivotlow(rsiVal, pivLeft, pivRight)
rsiPhFound = not na(rsiPH)
rsiPlFound = not na(rsiPL)

// Pivoty na CENIE (do formacji „2 cyce”)
prcPH = ta.pivothigh(high, pivLeft, pivRight)
prcPL = ta.pivotlow(low, pivLeft, pivRight)
prcPhFound = not na(prcPH)
prcPlFound = not na(prcPL)

// Indeks bara, na którym faktycznie wypadł potwierdzany właśnie pivot
pivBar = bar_index - pivRight

// Zamiana tekstu z ustawień na styl linii
f_style(string _s) =>
    _s == "Dashed" ? line.style_dashed : _s == "Dotted" ? line.style_dotted : line.style_solid

// Procentowa różnica dwóch wartości, liczona względem ich średniej
f_diffPct(float _a, float _b) =>
    math.abs(_a - _b) / ((_a + _b) / 2.0) * 100.0

// Siła dywergencji 0–100: suma dwóch składników po 50 pkt —
// rozjazdu RSI (|ΔRSI| / skala RSI) oraz ruchu ceny (|Δcena%| / skala ceny);
// każdy składnik nasyca się po osiągnięciu swojej skali
f_divStrength(float _r1, float _r2, float _p1, float _p2) =>
    float _dRsi = math.abs(_r2 - _r1)
    float _dPrc = _p1 != 0 ? math.abs(_p2 - _p1) / math.abs(_p1) * 100.0 : 0.0
    math.min(_dRsi / strRsiScale, 1.0) * 50.0 + math.min(_dPrc / strPrcScale, 1.0) * 50.0

// Rysowanie dywergencji: linia na panelu RSI + (opcjonalnie) linia na wykresie
// ceny + etykiety przy drugiej nodze formacji (opcjonalnie z oceną siły 0–100)
f_drawDiv(int _x1, float _r1, float _p1, int _x2, float _r2, float _p2, color _col, string _sty, int _wid, string _txt, bool _isBull, float _str) =>
    _style = f_style(_sty)
    _lblStyle = _isBull ? label.style_label_up : label.style_label_down
    string _lblTxt = showStrDiv ? _txt + " " + str.tostring(_str, "#") : _txt
    // linia na panelu RSI (po wartościach RSI)
    line.new(_x1, _r1, _x2, _r2, color = _col, width = _wid, style = _style)
    // linia na wykresie ceny (po low/high) — rysowana w panelu ceny dzięki force_overlay
    if showPriceLines
        line.new(_x1, _p1, _x2, _p2, color = _col, width = _wid, style = _style, force_overlay = true)
    // etykiety przy drugiej nodze
    if showLabels
        label.new(_x2, _r2, _lblTxt, style = _lblStyle, color = color.new(_col, 20), textcolor = color.white, size = size.small)
        if showPriceLines
            label.new(_x2, _p2, _lblTxt, style = _lblStyle, color = color.new(_col, 20), textcolor = color.white, size = size.small, force_overlay = true)

// ═════════════════════════════════════════════════════════════════════════════
//  3. DETECTION — WYKRYWANIE FORMACJI
// ═════════════════════════════════════════════════════════════════════════════

// Stan: ostatni potwierdzony pivot RSI — DOŁKI (bar, wartość RSI, cena low)
var int   rsiPlBar   = na
var float rsiPlVal   = na
var float rsiPlPrice = na

// Stan: ostatni potwierdzony pivot RSI — SZCZYTY (bar, wartość RSI, cena high)
var int   rsiPhBar   = na
var float rsiPhVal   = na
var float rsiPhPrice = na

// Stan: ostatnie potwierdzone pivoty CENOWE (do „2 cyce”)
var int   prcPhBar = na
var float prcPhVal = na
var int   prcPlBar = na
var float prcPlVal = na

// ── Dywergencje bycze (na pivotach dołków RSI) ───────────────────────────────
if rsiPlFound
    float _rsi   = rsiPL              // wartość RSI w dołku
    float _price = low[pivRight]      // cena (low) w barze dołka RSI
    if not na(rsiPlBar)
        int   _dist = pivBar - rsiPlBar
        float _str  = f_divStrength(rsiPlVal, _rsi, rsiPlPrice, _price)
        bool  _ok   = _dist >= minDist and _dist <= maxDist and math.abs(_rsi - rsiPlVal) >= minRsiDiff and _str >= minDivStr
        // Regular Bullish: cena niższy dołek (LL), RSI wyższy dołek (HL)
        if _ok and showRegBull and _price < rsiPlPrice and _rsi > rsiPlVal
            f_drawDiv(rsiPlBar, rsiPlVal, rsiPlPrice, pivBar, _rsi, _price, colRegBull, styRegBull, widRegBull, "Bull", true, _str)
        // Hidden Bullish: cena wyższy dołek (HL), RSI niższy dołek (LL)
        if _ok and showHidBull and _price > rsiPlPrice and _rsi < rsiPlVal
            f_drawDiv(rsiPlBar, rsiPlVal, rsiPlPrice, pivBar, _rsi, _price, colHidBull, styHidBull, widHidBull, "H.Bull", true, _str)
    // aktualizacja stanu — bieżący pivot staje się „poprzednim” dla następnego
    rsiPlBar   := pivBar
    rsiPlVal   := _rsi
    rsiPlPrice := _price

// ── Dywergencje niedźwiedzie (na pivotach szczytów RSI) ──────────────────────
if rsiPhFound
    float _rsi   = rsiPH              // wartość RSI na szczycie
    float _price = high[pivRight]     // cena (high) w barze szczytu RSI
    if not na(rsiPhBar)
        int   _dist = pivBar - rsiPhBar
        float _str  = f_divStrength(rsiPhVal, _rsi, rsiPhPrice, _price)
        bool  _ok   = _dist >= minDist and _dist <= maxDist and math.abs(_rsi - rsiPhVal) >= minRsiDiff and _str >= minDivStr
        // Regular Bearish: cena wyższy szczyt (HH), RSI niższy szczyt (LH)
        if _ok and showRegBear and _price > rsiPhPrice and _rsi < rsiPhVal
            f_drawDiv(rsiPhBar, rsiPhVal, rsiPhPrice, pivBar, _rsi, _price, colRegBear, styRegBear, widRegBear, "Bear", false, _str)
        // Hidden Bearish: cena niższy szczyt (LH), RSI wyższy szczyt (HH)
        if _ok and showHidBear and _price < rsiPhPrice and _rsi > rsiPhVal
            f_drawDiv(rsiPhBar, rsiPhVal, rsiPhPrice, pivBar, _rsi, _price, colHidBear, styHidBear, widHidBear, "H.Bear", false, _str)
    rsiPhBar   := pivBar
    rsiPhVal   := _rsi
    rsiPhPrice := _price

// ── Formacja „2 cyce” — podwójny SZCZYT ──────────────────────────────────────
// Warunki: dwa kolejne potwierdzone pivoty high na cenie o zbliżonej wysokości
// (tolerancja %), w zadanym zakresie odległości, z potwierdzonym pivotem low
// pomiędzy nimi. Detekcja PRZED aktualizacją stanu pivotów cenowych.
if prcPhFound and show2c and not na(prcPhBar)
    float _v        = prcPH
    int   _dist     = pivBar - prcPhBar
    bool  _valleyOk = not na(prcPlBar) and prcPlBar > prcPhBar          // dołek pomiędzy szczytami
    bool  _heightOk = f_diffPct(_v, prcPhVal) <= tol2c                  // zbliżona wysokość szczytów
    if _dist >= minDist and _dist <= maxDist and _heightOk and _valleyOk
        // linia łącząca oba szczyty — na wykresie ceny
        line.new(prcPhBar, prcPhVal, pivBar, _v, color = col2cTop, width = wid2c, style = f_style(sty2c), force_overlay = true)
        if showLabels
            label.new(pivBar, _v, "2 cyce", style = label.style_label_down, color = color.new(col2cTop, 20), textcolor = color.white, size = size.small, force_overlay = true)

// ── Formacja „2 cyce” — podwójny DOŁEK (wariant odwrócony) ───────────────────
if prcPlFound and show2c and not na(prcPlBar)
    float _v      = prcPL
    int   _dist   = pivBar - prcPlBar
    bool  _peakOk = not na(prcPhBar) and prcPhBar > prcPlBar            // szczyt pomiędzy dołkami
    bool  _depthOk = f_diffPct(_v, prcPlVal) <= tol2c                   // zbliżona głębokość dołków
    if _dist >= minDist and _dist <= maxDist and _depthOk and _peakOk
        // linia łącząca oba dołki — na wykresie ceny
        line.new(prcPlBar, prcPlVal, pivBar, _v, color = col2cBot, width = wid2c, style = f_style(sty2c), force_overlay = true)
        if showLabels
            label.new(pivBar, _v, "2 cyce (dno)", style = label.style_label_up, color = color.new(col2cBot, 20), textcolor = color.white, size = size.small, force_overlay = true)

// Aktualizacja stanu pivotów cenowych — celowo PO detekcji, żeby porównywać
// zawsze z poprzednim pivotem, a nie z bieżącym
if prcPhFound
    prcPhBar := pivBar
    prcPhVal := prcPH
if prcPlFound
    prcPlBar := pivBar
    prcPlVal := prcPL

// ═════════════════════════════════════════════════════════════════════════════
//  4. PLOTTING — RYSOWANIE RSI I POZIOMÓW
// ═════════════════════════════════════════════════════════════════════════════

// Linia RSI w panelu wskaźnika
plot(rsiVal, "RSI", color = colRsi, linewidth = 2)

// Poziomy 70 / 50 / 30 (ukrywane przez podanie `na`, gdy wyłączone)
pOB = plot(showLevels ? lvlOB : na, "Poziom wykupienia", color = color.new(color.gray, 40), linewidth = 1)
plot(showLevels ? lvlMid : na, "Poziom środkowy", color = color.new(color.gray, 65), linewidth = 1)
pOS = plot(showLevels ? lvlOS : na, "Poziom wyprzedania", color = color.new(color.gray, 40), linewidth = 1)

// Opcjonalne wypełnienie strefy między poziomami 70 i 30
fill(pOB, pOS, color = showFill and showLevels ? colFill : color(na), title = "Strefa 30–70")

// ═════════════════════════════════════════════════════════════════════════════
//  JAK UŻYWAĆ WSKAŹNIKA
// ═════════════════════════════════════════════════════════════════════════════
// 1. Wklej kod do Pine Editor w TradingView i kliknij „Add to chart”.
//    Wskaźnik pojawi się w osobnym panelu z RSI, a linie i etykiety formacji
//    zostaną narysowane także na głównym wykresie ceny (force_overlay).
// 2. Interpretacja etykiet:
//    • Bull    (Regular Bullish)  – cena LL, RSI HL → możliwe odwrócenie w górę
//    • H.Bull  (Hidden Bullish)   – cena HL, RSI LL → kontynuacja trendu wzrostowego
//    • Bear    (Regular Bearish)  – cena HH, RSI LH → możliwe odwrócenie w dół
//    • H.Bear  (Hidden Bearish)   – cena LH, RSI HH → kontynuacja trendu spadkowego
//    • 2 cyce / 2 cyce (dno)      – podwójny szczyt / podwójny dołek o zbliżonej
//      wysokości, z dołkiem/szczytem pomiędzy — klasyczna formacja odwrócenia
// 3. Sygnały pojawiają się DOPIERO po potwierdzeniu pivota, tj. „Pivot Right
//    Bars” barów po faktycznym ekstremum. Dzięki temu wskaźnik nie repaintuje,
//    ale sygnał jest z natury opóźniony — to świadomy kompromis.
// 4. Filtry: min/max odległość pivotów odsiewa formacje zbyt ciasne lub zbyt
//    rozciągnięte, „Min. różnica RSI” eliminuje słabe dywergencje, a
//    „Tolerancja wysokości (%)” decyduje, jak podobne muszą być oba
//    szczyty/dołki w formacji „2 cyce”.
// 4a. Siła dywergencji: każda dywergencja dostaje ocenę 0–100 (50 pkt za
//    wielkość rozjazdu RSI + 50 pkt za wielkość ruchu ceny między pivotami;
//    skale nasycenia obu składników są konfigurowalne). Suwak „Min. siła
//    dywergencji” odsiewa sygnały poniżej progu (0 = pokazuj wszystkie),
//    a ocena może być dopisywana do etykiety, np. „Bull 72”.
// 5. Każdy typ formacji ma osobny przełącznik, kolor, styl (Solid/Dashed/
//    Dotted) i grubość linii; linie na wykresie ceny oraz etykiety można
//    globalnie ukryć w grupie „Wyświetlanie”.
// 6. Wskaźnik jest narzędziem pomocniczym — nie stanowi rekomendacji
//    inwestycyjnej. Dobierz ustawienia pod konkretny rynek i interwał.
